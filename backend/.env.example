# Optional real MCP stdio servers. Local deterministic adapters are used by default.
# MCP_SERVERS={"research":{"command":"python","args":["-m","servers.local_servers","--server","search"]}}
# Gemini is used for DAG planning when GEMINI_API_KEY is present.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional USD per 1 million tokens. Leave unset to record token counts without pricing.
GEMINI_INPUT_USD_PER_1M=
GEMINI_OUTPUT_USD_PER_1M=
GEMINI_CACHED_INPUT_USD_PER_1M=
